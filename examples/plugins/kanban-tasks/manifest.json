{
  "id": "kanban-tasks",
  "name": "Quadro de Tarefas",
  "version": "1.1.0",
  "author": "Kiro",
  "description": "Quadro Kanban das tarefas: em preparação, a fazer, em progresso e finalizado. Arrasta os cartões entre colunas.",
  "minKiro": "0.17.7",
  "permissions": [
    "tasks:read",
    "tasks:write"
  ],
  "network": [],
  "page": {
    "title": "Quadro de Tarefas",
    "file": "board.html"
  },
  "settings": [
    {
      "key": "ordem",
      "type": "select",
      "label": "Ordenar tarefas por",
      "default": "Data",
      "choices": [
        "Data",
        "Prioridade",
        "Título"
      ]
    },
    {
      "key": "finalizadas",
      "type": "number",
      "label": "Tarefas visíveis em Finalizado",
      "default": 20,
      "min": 1,
      "max": 200
    }
  ]
}
