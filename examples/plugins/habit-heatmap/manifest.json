{
  "id": "habit-heatmap",
  "name": "Habit Heatmap",
  "version": "1.1.0",
  "author": "Kiro",
  "description": "Draws a heatmap of your habits, inside a note and on its own page.",
  "minKiro": "0.17.7",
  "permissions": [
    "habits:read"
  ],
  "network": [],
  "page": {
    "title": "Habit Heatmap",
    "file": "heatmap.html"
  },
  "settings": [
    {
      "key": "semanas",
      "type": "number",
      "label": "Semanas no mapa",
      "default": 26,
      "min": 4,
      "max": 52
    },
    {
      "key": "inicio",
      "type": "select",
      "label": "Semana começa em",
      "default": "Domingo",
      "choices": [
        "Domingo",
        "Segunda-feira"
      ]
    }
  ]
}
