{
  "name": "kiro",
  "version": "0.17.9",
  "private": true,
  "main": "electron/main.cjs",
  "scripts": {
    "start": "node server.mjs",
    "dev": "node --watch server.mjs --dev",
    "dev:reset": "node dev/seed.cjs --reset",
    "test": "node --test tests/*.test.cjs",
    "desktop": "electron .",
    "desktop:dev": "electron . --dev-vault",
    "mcp": "node mcp/server.mjs",
    "build:win": "electron-builder --win nsis",
    "review-graph": "node scripts/build-review-graph.mjs"
  },
  "build": {
    "appId": "com.kiro.local",
    "productName": "Kiro",
    "directories": {
      "output": "dist"
    },
    "files": [
      "**/*",
      "!vault/**",
      "!dev/**",
      "!scripts/**",
      "!dev-vault/**",
      "!work/**",
      "!outputs/**",
      "!tests/**",
      "!dist/**",
      "!.claude/**",
      "!.superpowers/**",
      "!docs/**",
      "!examples/**",
      "!graphify-out/**",
      "!{README,AGENTS,CLAUDE}.md",
      "!kuroi-*.json"
    ],
    "win": {
      "target": "nsis",
      "icon": "kiro-logo.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "Kiro-Setup-${version}.${ext}"
    },
    "asarUnpack": [
      "mcp/**",
      "agent/**",
      "vault.cjs",
      "domain.js",
      "fluxo.js",
      "node_modules/**"
    ]
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "js-yaml": "4.3.2"
  },
  "devDependencies": {
    "electron": "^44.1.1",
    "electron-builder": "^26.15.3"
  }
}
