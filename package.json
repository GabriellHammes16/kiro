{
  "name": "kiro",
  "version": "0.31.0",
  "description": "Segundo cérebro local-first: notas, tarefas, hábitos e fluxos.",
  "license": "GPL-3.0-or-later",
  "author": {
    "name": "Gabriel",
    "email": "164125568+GabriellHammes16@users.noreply.github.com"
  },
  "homepage": "https://github.com/GabriellHammes16/kiro",
  "desktopName": "kiro.desktop",
  "private": true,
  "main": "electron/main.cjs",
  "scripts": {
    "start": "node server.mjs",
    "dev": "node --watch server.mjs --dev",
    "dev:reset": "node dev/seed.cjs --reset",
    "test": "node --test tests/*.test.cjs",
    "test:vivo": "node tests/vivo/fluxo-vivo.mjs",
    "vendor:codemirror": "node scripts/build-codemirror.mjs",
    "vendor:pdfjs": "node scripts/build-pdfjs.mjs",
    "vendor:ortografia": "node scripts/build-ortografia.mjs",
    "desktop": "electron .",
    "desktop:dev": "electron . --dev-vault",
    "mcp": "node mcp/server.mjs",
    "build:win": "electron-builder --win nsis",
    "review-graph": "node scripts/build-review-graph.mjs",
    "build:linux": "electron-builder --linux AppImage deb"
  },
  "build": {
    "appId": "com.kiro.local",
    "asar": false,
    "productName": "Kiro",
    "directories": {
      "output": "dist"
    },
    "files": [
      "**/*",
      "!vault/**",
      "!dev/**",
      "!scripts/**",
      "!dev-vault/**",
      "!work/**",
      "!outputs/**",
      "!tests/**",
      "!dist/**",
      "!.claude/**",
      "!.superpowers/**",
      "!docs/**",
      "!examples/**",
      "!graphify-out/**",
      "!{README,AGENTS,CLAUDE}.md",
      "!kuroi-*.json",
      "!kiro logo preta e branca/**"
    ],
    "win": {
      "target": [
        "nsis",
        "zip"
      ],
      "signAndEditExecutable": false,
      "icon": "kiro.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "Kiro-Setup-${version}.${ext}"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "icon": "kiro-logo.png",
      "category": "Office",
      "executableName": "kiro",
      "artifactName": "Kiro-${version}.${ext}",
      "syncDesktopName": true
    },
    "asarUnpack": [
      "mcp/**",
      "agent/**",
      "vault.cjs",
      "domain.js",
      "fluxo.js",
      "corretor.js",
      "node_modules/**"
    ],
    "extraResources": [
      {
        "from": "examples/plugins/focus-pomodoro",
        "to": "plugins/focus-pomodoro",
        "filter": [
          "manifest.json",
          "*.js",
          "*.html",
          "*.css"
        ]
      },
      {
        "from": "examples/plugins/flashcards",
        "to": "plugins/flashcards",
        "filter": [
          "manifest.json",
          "*.js",
          "*.html",
          "*.css"
        ]
      },
      {
        "from": "examples/plugins/weekly-review",
        "to": "plugins/weekly-review",
        "filter": [
          "manifest.json",
          "*.js",
          "*.html",
          "*.css"
        ]
      },
      {
        "from": "examples/plugins/slides",
        "to": "plugins/slides",
        "filter": [
          "manifest.json",
          "*.js",
          "*.html",
          "*.css"
        ]
      }
    ]
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "js-yaml": "4.3.2"
  },
  "devDependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.12.4",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.13",
    "@lezer/markdown": "^1.7.2",
    "dictionary-en": "^4.0.0",
    "dictionary-pt": "^4.0.0",
    "electron": "^44.1.1",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "hunspell-asm": "^4.0.2",
    "pdfjs-dist": "^4.10.38"
  }
}
